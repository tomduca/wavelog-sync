# Copiar a .env y completar. .env no se comparte ni se sube a git.

# Wavelog: URL base de tu instancia (la que precede a /api/...). Si tu instalación usa
# index.php en las URLs, incluilo: https://tu-wavelog.ejemplo/index.php
WAVELOG_URL=https://tu-wavelog.ejemplo
# API key (alcanza con una de solo lectura): Wavelog > menú de usuario > API Keys
WAVELOG_API_KEY=

# Sólo se consideran QSOs desde esta fecha/hora (UTC). Evita subir todo el log histórico
# la primera vez. Formato: AAAA-MM-DD HH:MM
SYNC_DESDE=2026-10-01 00:00

# QRZ.com (cuenta gratuita, vía navegador). No guarda usuario ni contraseña: el login es
# manual (./wavelog-sync.sh --qrz-login) y la sesión queda en estado/qrz_navegador.
# Nombre exacto del logbook en QRZ, como aparece en Awards. Opcional; default "<LDA_MICALL> Log".
QRZ_LIBRO=

# LogDeArgentina (API subeqso2.php)
LDA_USER=
LDA_PASS=
# Indicativo propio. Se usa si el QSO no trae STATION_CALLSIGN y para el nombre del libro de QRZ
LDA_MICALL=
# Mensaje opcional para la QSL de LdA
LDA_QSL_MSG=
